{
  "manifest_version": 2,
  "name": "Firefox AI Extension",
  "version": "1.0",
  "description": "Generates alt text for images and summarizes text using Firefox AI Runtime.",
  "permissions": [
    "activeTab",
    "<all_urls>",
    "menus",
    "scripting"
  ],
  "optional_permissions": [
    "trialML"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    "settings.html",
    "alt-text-modal.css",
    "content-script.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-extension@example.com"
    }
  }
}